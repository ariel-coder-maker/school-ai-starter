# The engine's private settings. Copy this file to engine/.env and fill it in
# YOURSELF, in a text editor. Never paste a key into a chat, and never share
# this file. .gitignore keeps engine/.env out of git.
#
# You need at least ONE AI key. Where to get each, and what it costs:
# engine/PROVIDERS.md. A step whose key is empty is skipped, with a reason.

# ── AI providers (fill in at least one) ──────────────────────────────────────
NVIDIA_API_KEY=
NVIDIA_MODEL=
DASHSCOPE_API_KEY=
# Alibaba keys work in one region only. International is the default; change
# this only if your key is from another region (see PROVIDERS.md).
DASHSCOPE_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# ── Spending ─────────────────────────────────────────────────────────────────
# The engine refuses new AI calls once this month's logged spend reaches this.
# ALSO set a limit on each provider's website: that is the one that actually
# stops charges.
MONTHLY_LIMIT_USD=10

# ── This computer ────────────────────────────────────────────────────────────
# Change once, before the first start. It protects the database.
POSTGRES_PASSWORD=change-me-once
N8N_PORT=5678
ENGINE_PORT=3000
TIMEZONE=UTC
